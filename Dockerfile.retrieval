FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PORT=8080

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:0.8.14 /uv /uvx /bin/
RUN uv venv /app/.venv && \
    uv pip install --python /app/.venv/bin/python "numpy>=1.21,<3"

COPY src ./src
COPY docs ./docs
COPY retrieval ./retrieval
COPY scripts/serve_api_retrieval.py ./scripts/serve_api_retrieval.py

EXPOSE 8080

CMD ["/bin/sh", "-c", "exec /app/.venv/bin/python scripts/serve_api_retrieval.py --host 0.0.0.0 --port ${PORT}"]
